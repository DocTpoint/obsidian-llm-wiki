{
  // The repo's tsconfig includes only `src/**/*.ts`, so nothing type-checked
  // this directory: `run-llm-wiki.mjs` bundles it with esbuild, which strips
  // types without looking at them. Roughly two thirds of the CLI shipped
  // unchecked, and three real errors were sitting in it.
  //
  // Separate from the plugin's config rather than merged into it because the
  // two run on different platforms: the plugin targets the Obsidian renderer
  // and must never see Node globals, while this is a Node program.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts"]
}
